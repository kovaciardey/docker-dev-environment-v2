# ==============================================
# Symfony Development Environment Configuration
# ==============================================

# Copy this file to .env and customize as needed
# The dev.py init command will handle this automatically

# ---------------------------------------------
# User ID Mapping (for permission management)
# ---------------------------------------------
# These will be auto-detected by dev.py init
# USER_ID=1000
# GROUP_ID=1000

# ---------------------------------------------
# Symfony Configuration
# ---------------------------------------------
APP_ENV=dev
APP_SECRET=your-secret-key-change-in-production

# ---------------------------------------------
# MySQL Database Configuration
# ---------------------------------------------
MYSQL_ROOT_PASSWORD=root

# ---------------------------------------------
# Xdebug (PHP container)
# ---------------------------------------------
# debug    - default: step debugging, connects to the IDE only when XDEBUG_TRIGGER is set
# off      - Xdebug fully off (fastest; use it when you don't need the debugger)
# coverage - not needed here: the API's coverage script sets it itself
# After changing it run `dev up` (it recreates the container). No rebuild is needed;
# `dev restart` isn't enough (it restarts the container with its old settings).
# XDEBUG_MODE=debug

# ---------------------------------------------
# Project Repositories (for dev setup commands)
# ---------------------------------------------
# Uncomment and set your repository URLs
SYMFONY_REPO=https://github.com/yourusername/symfony-api.git
VUE_REPO=https://github.com/yourusername/vue-frontend.git
